# Copy to .env.local for development. In Vercel, set these in Project Settings -> Environment Variables.
# Required unless marked optional.

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_URL=http://localhost:3000

# --- Clerk (auth) ----------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# --- YouTube Data API v3 ---------------------------------------------------
YOUTUBE_API_KEY=xxx
# Optional: units/day the app may spend before refusing uncached calls (Google's cap is 10,000).
YOUTUBE_DAILY_QUOTA_BUDGET=9000

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=sk-xxx
# Optional model overrides
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
# Optional: hard ceiling on tokens across ALL users per rolling 24h
OPENAI_GLOBAL_DAILY_TOKEN_BUDGET=3000000

# --- Public CTR grader (lead magnet) ---------------------------------------
# Optional: free grades per visitor IP per day, and across all visitors per day
PUBLIC_GRADER_PER_IP_DAILY=3
PUBLIC_GRADER_GLOBAL_DAILY=300
# Optional but recommended: salt for hashing visitor IPs (never stored raw)
IP_HASH_SALT=change-me-to-a-random-string

# --- Stripe ----------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx
# Optional: free-trial length for new Pro subscriptions (0 or unset = no trial)
STRIPE_TRIAL_DAYS=0
